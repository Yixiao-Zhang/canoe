<comment>
problem   = Moist rising bubble test
reference = Bryan and Fritsch, 2002
configure = --prob=geyser --flux=lmars --nvapor=2 --nphase=2 --nghost=3 -pnetcdf -mpi

<job>
problem_id  = corner       # problem ID: basename of output filenames
tasklist    = ImplicitHydroTasks

<output1>
file_type   = hst           # History data dump
dt          = 10.          # time increment between outputs

<output2>
file_type   = pnetcdf       # Netcdf format output
variable    = prim          # variables to be output
dt          = 1e-1          # time increment between outputs

<output3>
file_type   = pnetcdf       # Netcdf format output
variable    = uov           # diagnostic variables
dt          = 1e-1          # time increment

<output4>
file_type   = rst           # History data dump
dt          = 10.           # time increment between outputs

<time>
cfl_number  = 0.4           # The Courant, Friedrichs, & Lewy (CFL) Number
nlim        = -1            # cycle limit
tlim        = 100.            # time limit
xorder      = 1             # horizontal reconstruction order
integrator  = rk3           # integration method

<mesh>
nx1         = 400
x1min       = 0.
x1max       = 10e3.
ix1_bc      = user
ox1_bc      = outflow
x1rat       = 1.0175

nx2         = 400
x2min       = 0.
x2max       = 10e3
ix2_bc      = reflecting
ox2_bc      = outflow
x2rat       = 1.0175

nx3         = 1
x3min       = 0.
x3max       = 1.
ix3_bc      = periodic
ox3_bc      = periodic

<meshblock>
nx1         = 100
nx2         = 200
nx3         = 1

<hydro>
gamma      = 1.4        # gamma = C_pd/C_vd
implicit_flag = 0
dfloor = 1e-53
pfloor = 1e-53

<problem>
thermodynamics_config = geyser_h2o.yaml

forcing_wall_interaction = false

# nu_iso = 12e-6
# kappa_iso = 12e-6
nu_iso = 0.
kappa_iso = 0.

bc_vacuum = true

outerspace_pressure = 1e-20

exit_delta = 0.1
exit_center_velocity = 30.
exit_temperature = 220.

