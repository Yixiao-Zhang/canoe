<comment>
problem   = Moist rising bubble test
reference = Bryan and Fritsch, 2002
configure = --prob=lava_planet --flux=lmars --nvapor=2 --nphase=2 --nghost=3 --coord=spherical_polar -pnetcdf -mpi 

<job>
problem_id  = lava_planet        # problem ID: basename of output filenames
tasklist    = ImplicitHydroTasks

<output1>
file_type   = hst           # History data dump
dt          = 60           # time increment between outputs
# dcycle = 1

<output2>
file_type   = pnetcdf       # Netcdf format output
variable    = prim          # variables to be output
dt          = 60           # time increment between outputs
# dcycle = 1

<output3>
file_type   = pnetcdf       # Netcdf format output
variable    = uov           # diagnostic variables
dt          = 60           # time increment
# dcycle = 1

<output4>
file_type   = rst           # History data dump
dt          = 10000           # time increment between outputs

<time>
cfl_number  = 0.4           # The Courant, Friedrichs, & Lewy (CFL) Number
nlim        = -1            # cycle limit
tlim        = 86400.        # time limit
xorder      = 1             # horizontal reconstruction order
integrator  = rk3           # integration method


<mesh>
# r: radial shell
nx1    = 40
x1min  = 6500.E3
x1max  = 6600.E3
ix1_bc = reflecting
ox1_bc = outflow

# theta: full colatitude (0 → π)
nx2    = 80
x2min  = 0.05
x2max  = 3.1
ix2_bc = reflecting
ox2_bc = reflecting

# phi: full azimuth (0 → 2π)
nx3    = 80
x3min  = 0.05
x3max  = 6.2
ix3_bc = periodic
ox3_bc = periodic


<meshblock>
nx1 = 40
nx2 = 20
nx3 = 20

<hydro>
gamma      = 1.33    # - gamma = C_pd/C_vd
implicit_flag = 0
grav_acc1   = -9.

<problem>
thermodynamics_config = lava_sio_only.yaml
radius = 6500.E3
massflux_CO2ratio = 0.01 # - injected mass ratio of CO2

<initialcondition>
SiOratio=0.
CO2ratio=0.
